@model AspNet.MVC.Models.Products.ProductCreateModel

@{
    ViewData["Title"] = "Create Product";
}

<div class="dashboard-heading">
    <div>
        <h2>Create Product</h2>
        <p>Add a new product to your inventory.</p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        ← Back to Products
    </a>
</div>

<div class="form-panel">

    <div class="form-panel-header">
        <h5>Product Information</h5>
        <p>Enter the details of the new product.</p>
    </div>

    <form asp-action="Create" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <div class="mb-4">
            <label asp-for="Name" class="form-label">
                Product Name
            </label>

            <input asp-for="Name"
                   class="form-control"
                   placeholder="Enter product name" />

            <span asp-validation-for="Name"
                  class="text-danger small">
            </span>
        </div>

        <div class="mb-4">
            <label asp-for="Price" class="form-label">
                Price
            </label>

            <input asp-for="Price"
                   type="number"
                   min="0"
                   step="0.01"
                   class="form-control"
                   placeholder="Enter product price" />

            <span asp-validation-for="Price"
                  class="text-danger small">
            </span>
        </div>

        <div class="mb-4">
            <label asp-for="CategoryId" class="form-label">
                Category ID
            </label>

            <input asp-for="CategoryId"
                   type="number"
                   min="1"
                   step="1"
                   class="form-control"
                   placeholder="Enter category ID" />

            <span asp-validation-for="CategoryId"
                  class="text-danger small">
            </span>
        </div>

        <div class="form-actions">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancel
            </a>

            <button type="submit" class="btn-primary-custom">
                Create Product
            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
