@model AspNet.MVC.Models.Products.ProductUpdateModel

@{
    ViewData["Title"] = "Edit Product";
}

<div class="dashboard-heading">
    <div>
        <h2>Edit Product</h2>
        <p>Update product information.</p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        ← Back to Products
    </a>
</div>

<div class="form-panel">

    <div class="form-panel-header">
        <h5>Product Information</h5>
        <p>Product ID: #@ViewBag.ProductId</p>
    </div>

    <form asp-action="Edit"
          asp-route-id="@ViewBag.ProductId"
          method="post">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <div class="mb-4">
            <label asp-for="Name" class="form-label">
                Product Name
            </label>

            <input asp-for="Name"
                   class="form-control" />

            <span asp-validation-for="Name"
                  class="text-danger small">
            </span>
        </div>

        <div class="mb-4">
            <label asp-for="Price" class="form-label">
                Price
            </label>

            <input asp-for="Price"
                   type="number"
                   step="0.01"
                   class="form-control" />

            <span asp-validation-for="Price"
                  class="text-danger small">
            </span>
        </div>

        <div class="mb-4">
            <label asp-for="CategoryId" class="form-label">
                Category ID
            </label>

            <input asp-for="CategoryId"
                   type="number"
                   class="form-control" />

            <span asp-validation-for="CategoryId"
                  class="text-danger small">
            </span>
        </div>

        <div class="form-actions">
            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancel
            </a>

            <button type="submit" class="btn-primary-custom">
                Save Changes
            </button>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
