
@model AspNet.MVC.Models.Dashboard.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="dashboard-heading">
    <div>
        <h2>Welcome back, Administrator 👋</h2>
        <p>Here's what's happening with your application today.</p>
    </div>

    <a asp-controller="Admin"
       asp-action="Index"
       class="dashboard-date text-decoration-none">

        <span>◷</span> Overview
    </a>
</div>

@if (!Model.IsSystemHealthy)
{
        <div class="alert alert-warning mb-4">
            Some dashboard statistics could not be loaded.
            Please check API availability and try again.
        </div>
}

<!-- Statistics -->
<div class="row g-4 mb-4">

    <!-- Products -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <span>Total Products</span>
                <div class="stat-icon icon-blue">▤</div>
            </div>

            <h3>
                @(Model.TotalProducts?.ToString("N0") ?? "—")
            </h3>

            <p>Products in inventory</p>
        </div>
    </div>

    <!-- Categories -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <span>Categories</span>
                <div class="stat-icon icon-purple">▧</div>
            </div>

            <h3>
                @(Model.TotalCategories?.ToString("N0") ?? "—")
            </h3>

            <p>Organized categories</p>
        </div>
    </div>

    <!-- Tags -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <span>Total Tags</span>
                <div class="stat-icon icon-orange">◇</div>
            </div>

            <h3>
                @(Model.TotalTags?.ToString("N0") ?? "—")
            </h3>

            <p>Available tags</p>
        </div>
    </div>

    <!-- System Status -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-top">
                <span>System Status</span>

                <div class="stat-icon @(Model.IsSystemHealthy ? "icon-green" : "icon-orange")">
                    @(Model.IsSystemHealthy ? "✓" : "!")
                </div>
            </div>

            <h3 class="@(Model.IsSystemHealthy ? "healthy" : "text-warning")">
                @Model.SystemStatus
            </h3>

            <p>
                @(Model.IsSystemHealthy
                        ? "All APIs responding"
                        : "API connection issue")
            </p>
        </div>
    </div>

</div>

<!-- Dashboard Content -->
<div class="row g-4">

    <!-- Recent Activity / Module Status -->
    <div class="col-12 col-xl-8">
        <div class="dashboard-panel">

            <div class="panel-header">
                <div>
                    <h5>Recent Activity</h5>
                    <p>Overview of your application modules</p>
                </div>

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="panel-menu text-decoration-none"
                   title="Refresh dashboard">
                    ↻
                </a>
            </div>

            <div class="table-responsive">
                <table class="dashboard-table">
                    <thead>
                        <tr>
                            <th>ACTIVITY</th>
                            <th>MODULE</th>
                            <th>STATUS</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>Product management</td>
                            <td>
                                <a asp-controller="Products"
                                   asp-action="Index">
                                    Products
                                </a>
                            </td>
                            <td>
                                <span class="status-badge">
                                    @(Model.TotalProducts.HasValue ? "Ready" : "Unavailable")
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <td>Category management</td>
                            <td>
                                <a asp-controller="Categories"
                                   asp-action="Index">
                                    Categories
                                </a>
                            </td>
                            <td>
                                <span class="status-badge">
                                    @(Model.TotalCategories.HasValue ? "Ready" : "Unavailable")
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <td>Tag management</td>
                            <td>
                                <a asp-controller="Tags"
                                   asp-action="Index">
                                    Tags
                                </a>
                            </td>
                            <td>
                                <span class="status-badge">
                                    @(Model.TotalTags.HasValue ? "Ready" : "Unavailable")
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
    </div>

    <!-- Quick Actions -->
    <div class="col-12 col-xl-4">
        <div class="dashboard-panel">

            <div class="panel-header">
                <div>
                    <h5>Quick Actions</h5>
                    <p>Manage your resources</p>
                </div>
            </div>

            <div class="quick-actions">

                <!-- Add Product -->
                <a asp-controller="Products"
                   asp-action="Create"
                   class="quick-action">

                    <span class="action-icon icon-blue">+</span>

                    <span>
                        <strong>Add Product</strong>
                        <small>Create a new product</small>
                    </span>

                    <span class="action-arrow">→</span>
                </a>

                <!-- Add Category -->
                <a asp-controller="Categories"
                   asp-action="Create"
                   class="quick-action">

                    <span class="action-icon icon-purple">+</span>

                    <span>
                        <strong>Add Category</strong>
                        <small>Create a new category</small>
                    </span>

                    <span class="action-arrow">→</span>
                </a>

                <!-- Add Tag -->
                <a asp-controller="Tags"
                   asp-action="Create"
                   class="quick-action">

                    <span class="action-icon icon-orange">+</span>

                    <span>
                        <strong>Add Tag</strong>
                        <small>Create a new tag</small>
                    </span>

                    <span class="action-arrow">→</span>
                </a>

            </div>
        </div>
    </div>

</div>
