@model IReadOnlyList<AspNet.MVC.Models.Users.RoleDetailsViewModel>

@{
    ViewData["Title"] = "Roles";
}

<div class="content-header mb-4">
    <h3>Roles Management</h3>
    <p class="text-muted">
        Manage system roles and review assigned users
    </p>
</div>

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-4">
    @foreach (var role in Model)
    {
        var description = role.Name switch
        {
            "Admin" => "Full administrative access",
            "Manager" => "Management access",
            "Customer" => "Standard customer access",
            _ => "System role"
        };

        <div class="col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="rounded-3 bg-primary-subtle text-primary p-3">
                            <span class="fs-4">⚿</span>
                        </div>

                        <span class="badge bg-primary-subtle text-primary">
                            System Role
                        </span>
                    </div>

                    <h4>@role.Name</h4>

                    <p class="text-muted">@description</p>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div>
                            <h3 class="mb-0">@role.UserCount</h3>
                            <small class="text-muted">Assigned users</small>
                        </div>

                        <a asp-action="Details"
                           asp-route-id="@role.Name"
                           class="btn btn-outline-primary">
                            View Users
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
