@model AspNet.MVC.Models.Users.RoleDetailsViewModel

@{
    ViewData["Title"] = $"{Model.Name} Role";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none">
        ← Back to Roles
    </a>

    <h3 class="mt-3">@Model.Name Role</h3>

    <p class="text-muted">
        Users assigned to this role
    </p>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="mb-0">Assigned Users</h5>

            <span class="badge bg-primary">
                @Model.UserCount Users
            </span>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>All Roles</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Users.Count == 0)
                    {
                        <tr>
                            <td colspan="4"
                                class="text-center text-muted py-4">
                                No users assigned to this role.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in Model.Users)
                        {
                            var fullName =
                            $"{user.FirstName} {user.LastName}".Trim();

                            <tr>
                                <td>
                                    @(string.IsNullOrWhiteSpace(fullName)
                                        ? "Unnamed User"
                                        : fullName)
                                </td>

                                <td>@user.Email</td>

                                <td>
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="badge bg-primary-subtle text-primary me-1">
                                            @role
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a asp-controller="Users"
                                       asp-action="Details"
                                       asp-route-id="@user.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
