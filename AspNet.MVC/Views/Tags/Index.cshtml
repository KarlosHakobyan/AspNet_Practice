@model IEnumerable<AspNet.MVC.Models.Tags.TagModel>

@{
    ViewData["Title"] = "Tags";

    var tags = Model.ToList();
    var isAdmin = User.IsInRole("Admin");
}

<div class="dashboard-heading">
    <div>
        <h2>Tags</h2>
        <p>
            @(isAdmin
                ? "Manage tags assigned to your products."
                : "Browse tags assigned to products.")
        </p>
    </div>

    @if (isAdmin)
    {
        <a asp-action="Create" class="btn-primary-custom">
            + Add Tag
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

<div class="dashboard-panel">
    <div class="panel-header">
        <div>
            <h5>All Tags</h5>
            <p>
                @(isAdmin
                    ? "Manage your available product tags"
                    : "Explore available product tags")
            </p>
        </div>

        <span class="text-muted">
            Total: @tags.Count
        </span>
    </div>

    <div class="table-responsive">
        <table class="dashboard-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>TAG NAME</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>

            <tbody>
                @if (tags.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="text-center py-5">
                            No tags found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var tag in tags)
                    {
                        <tr>
                            <td>#@tag.Id</td>

                            <td>
                                <span class="tag-chip">@tag.Name</span>
                            </td>

                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Details"
                                       asp-route-id="@tag.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        View
                                    </a>

                                    @if (isAdmin)
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@tag.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@tag.Id"
                                              method="post"
                                              onsubmit="return confirm('Delete this tag?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
