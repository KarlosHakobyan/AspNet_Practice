@model AspNet.MVC.Models.Users.UserRolesViewModel

@{
    ViewData["Title"] = "Manage User Roles";
}

<div class="mb-4">
    <a asp-action="Details"
       asp-route-id="@Model.Id"
       class="text-decoration-none">
        ← Back to User
    </a>

    <h3 class="mt-3">Manage Roles</h3>
    <p class="text-muted">
        Assign or remove permissions for @Model.Email
    </p>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Roles"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <input asp-for="Id" type="hidden" />
            <input asp-for="Email" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            <h5 class="mb-3">Available Roles</h5>

            <p class="text-muted">
                Select all roles that should be assigned to this user.
            </p>

            @foreach (var role in Model.AvailableRoles)
            {
                var selected = Model.SelectedRoles.Contains(
                role,
                StringComparer.OrdinalIgnoreCase);

                <div class="form-check border rounded p-3 ps-5 mb-2">
                    <input class="form-check-input"
                           type="checkbox"
                           name="SelectedRoles"
                           value="@role"
                           checked="@selected" />

                    <label class="form-check-label">
                        <strong>@role</strong>

                        <div class="small text-muted">
                            @switch (role)
                            {
                                case "Admin":
                                    @:Full administrative access.
                                    break;
                                case "Manager":
                                    @:Management access.
                                    break;
                                case "Customer":
                                    @:Standard customer access.
                                    break;
                            }
                        </div>
                    </label>
                </div>
            }

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    Save Roles
                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-light">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>
