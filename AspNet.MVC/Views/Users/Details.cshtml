@model AspNet.MVC.Models.Users.UserDetailsViewModel

@{
    ViewData["Title"] = "User Details";
    var fullName = $"{Model.FirstName} {Model.LastName}".Trim();
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none">
        ← Back to Users
    </a>

    <h3 class="mt-3">User Details</h3>
    <p class="text-muted">View and manage user information</p>
</div>

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="user-avatar">
                        @(string.IsNullOrWhiteSpace(fullName)
                            ? "U"
                            : fullName[..1].ToUpperInvariant())
                    </div>

                    <div>
                        <h4 class="mb-1">
                            @(string.IsNullOrWhiteSpace(fullName)
                                ? "Unnamed User"
                                : fullName)
                        </h4>

                        <div class="text-muted">@Model.Email</div>
                    </div>
                </div>

                <hr />

                <dl class="row mb-0">
                    <dt class="col-sm-4">User ID</dt>
                    <dd class="col-sm-8 text-break">@Model.Id</dd>

                    <dt class="col-sm-4">First Name</dt>
                    <dd class="col-sm-8">@Model.FirstName</dd>

                    <dt class="col-sm-4">Last Name</dt>
                    <dd class="col-sm-8">@Model.LastName</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">
                        @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                            ? "Not provided"
                            : Model.PhoneNumber)
                    </dd>

                    <dt class="col-sm-4">Email Confirmed</dt>
                    <dd class="col-sm-8">
                        @(Model.EmailConfirmed ? "Yes" : "No")
                    </dd>

                    <dt class="col-sm-4">Account Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsLockedOut)
                        {
                            <span class="badge bg-danger">Locked</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Lockout Until</dt>
                    <dd class="col-sm-8">
                        @(Model.LockoutEnd?.ToLocalTime().ToString("g") ?? "—")
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h5 class="mb-3">Assigned Roles</h5>

                @if (Model.Roles.Count == 0)
                {
                    <p class="text-muted">No roles assigned.</p>
                }
                else
                {
                    @foreach (var role in Model.Roles)
                    {
                        <div class="mb-2">
                            <span class="badge bg-primary-subtle text-primary fs-6">
                                @role
                            </span>
                        </div>
                    }
                }

                <a asp-action="Roles"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-primary w-100 mt-3">
                    Manage Roles
                </a>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h5 class="mb-3">Account Actions</h5>

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary w-100 mb-2">
                    Edit Profile
                </a>

                @if (Model.IsLockedOut)
                {
                    <form asp-action="Unlock"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-success w-100">
                            Unlock Account
                        </button>
                    </form>
                }
                else
                {
                    <form asp-action="Lock"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="Id" value="@Model.Id" />
                        <input type="hidden" name="LockoutDays" value="30" />

                        <button type="submit"
                                class="btn btn-outline-danger w-100"
                                onclick="return confirm('Lock this user for 30 days?');">
                            Lock Account
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
