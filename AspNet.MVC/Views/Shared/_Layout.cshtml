@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var isAdmin = User.IsInRole("Admin");
    var isManager = User.IsInRole("Manager");
    var isCustomer = User.IsInRole("Customer");

    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    var displayName = User.Identity?.Name;

    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = "User";
    }

    var displayRole = isAdmin ? "Administrator"
        : isManager ? "Manager"
        : isCustomer ? "Customer"
        : "User";

    var avatar = displayName.Substring(0, 1).ToUpperInvariant();

    var dashboardController = isAdmin ? "Admin"
        : isManager ? "Manager"
        : "Customer";

    var isDashboardActive =
        currentController == "Home" ||
        currentController == "Admin" ||
        currentController == "Manager" ||
        currentController == "Customer";

    var isUsersActive = currentController == "Users";
    var isRolesActive = currentController == "Roles";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AspNet Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AspNet.MVC.styles.css" asp-append-version="true" />
</head>

<body>

    <div class="admin-layout">

        <!-- Sidebar -->
        <aside class="sidebar">

            <!-- Brand -->
            <div class="sidebar-brand">
                <span class="brand-icon">A</span>
                <span>AspNet Admin</span>
            </div>

            <!-- Navigation -->
            <nav class="sidebar-nav">

                <div class="nav-section-title">
                    MAIN MENU
                </div>

                <!-- Dashboard -->
                @if (isAuthenticated)
                {
                    <a asp-controller="@dashboardController"
                       asp-action="Index"
                       class="nav-item @(isDashboardActive ? "active" : "")">

                        <span>▦</span>
                        Dashboard
                    </a>
                }

                <!-- Products -->
                @if (isAdmin || isManager || isCustomer)
                {
                    <a asp-controller="Products"
                       asp-action="Index"
                       class="nav-item @(currentController == "Products" ? "active" : "")">

                        <span>▤</span>
                        Products
                    </a>

                    <!-- Categories -->
                    <a asp-controller="Categories"
                       asp-action="Index"
                       class="nav-item @(currentController == "Categories" ? "active" : "")">

                        <span>▧</span>
                        Categories
                    </a>

                    <!-- Tags -->
                    <a asp-controller="Tags"
                       asp-action="Index"
                       class="nav-item @(currentController == "Tags" ? "active" : "")">

                        <span>◇</span>
                        Tags
                    </a>
                }

                <!-- Administration -->
                @if (isAdmin)
                {
                    <div class="nav-section-title">
                        ADMINISTRATION
                    </div>

                    <!-- Users -->
                    <a asp-controller="Users"
                       asp-action="Index"
                       class="nav-item @(isUsersActive ? "active" : "")">

                        <span>♙</span>
                        Users
                    </a>

                    <!-- Roles -->
                    <a asp-controller="Roles"
                       asp-action="Index"
                       class="nav-item @(isRolesActive ? "active" : "")">

                        <span>⚿</span>
                        Roles
                    </a>
                }

                <!-- System -->
                @if (isAuthenticated)
                {
                    <div class="nav-section-title">
                        SYSTEM
                    </div>

                    <a href="#"
                       class="nav-item"
                       title="Settings will be implemented later">

                        <span>⚙</span>
                        Settings
                    </a>
                }

            </nav>

            <!-- Sidebar Footer -->
            @if (isAuthenticated)
            {
                <div class="sidebar-footer">

                    <div class="user-avatar">
                        @avatar
                    </div>

                    <div>
                        <div class="user-name">
                            @displayName
                        </div>

                        <div class="user-role">
                            @displayRole
                        </div>
                    </div>

                </div>
            }

        </aside>

        <!-- Main Wrapper -->
        <div class="main-wrapper">

            <!-- Topbar -->
            <header class="topbar">

                <div>
                    <h5 class="page-title">
                        @ViewData["Title"]
                    </h5>

                    <p class="page-subtitle">
                        Manage your application
                    </p>
                </div>

                @if (isAuthenticated)
                {
                    <div class="admin-profile">

                        <span class="online-indicator"></span>

                        <span>@displayRole</span>

                        <div class="user-avatar">
                            @avatar
                        </div>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="logout-form">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-secondary btn-sm">
                                Logout
                            </button>
                        </form>

                    </div>
                }

            </header>

            <!-- Main Content -->
            <main class="main-content">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="main-footer">
                © @DateTime.Now.Year AspNet Admin. All rights reserved.
            </footer>

        </div>

    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
