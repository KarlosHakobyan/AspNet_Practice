
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AspNet Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AspNet.MVC.styles.css" asp-append-version="true" />
</head>

<body>

    <div class="admin-layout">

        <!-- Sidebar -->
        <aside class="sidebar">

            <div class="sidebar-brand">
                <span class="brand-icon">A</span>
                <span>AspNet Admin</span>
            </div>

            <nav class="sidebar-nav">

                <div class="nav-section-title">MAIN MENU</div>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="nav-item">
                    <span>▦</span>
                    Dashboard
                </a>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="nav-item">
                    <span>▤</span>
                    Products
                </a>

                <a asp-controller="Categories"
                   asp-action="Index"
                   class="nav-item">
                    <span>▧</span>
                    Categories
                </a>

                <a asp-controller="Tags"
                   asp-action="Index"
                   class="nav-item">
                    <span>◇</span>
                    Tags
                </a>

                <div class="nav-section-title">SYSTEM</div>

                <a href="#" class="nav-item">
                    <span>⚙</span>
                    Settings
                </a>

            </nav>

            <div class="sidebar-footer">

                <div class="user-avatar">K</div>

                <div>
                    <div class="user-name">Administrator</div>
                    <div class="user-role">System Admin</div>
                </div>

            </div>

        </aside>

        <!-- Main Content -->
        <div class="main-wrapper">

            <!-- Header -->
            <header class="topbar">

                <div>
                    <h5 class="page-title">@ViewData["Title"]</h5>
                    <p class="page-subtitle">Manage your application</p>
                </div>

                <div class="admin-profile">
                    <span class="online-indicator"></span>
                    <span>Administrator</span>
                    <div class="user-avatar">K</div>
                </div>

            </header>

            <!-- Page Content -->
            <main class="main-content">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="main-footer">
                © @DateTime.Now.Year AspNet Admin. All rights reserved.
            </footer>

        </div>

    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
